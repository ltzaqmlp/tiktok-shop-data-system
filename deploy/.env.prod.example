# Production normally keeps using deploy/.env for backward compatibility.
# Copy this file to .env.prod only if you want a separately named production file.
DB_PASSWORD=replace-with-a-long-random-database-password
DB_ADMIN_PASSWORD=replace-with-a-different-database-admin-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-initial-password
INITIAL_SHOP_KEY=MY_MAIN
INITIAL_SHOP_NAME=马来西亚主店
# Keep shop-operations when adopting this on the existing installation.
DATA_VOLUME_PREFIX=shop-operations
DB_PORT_HOST=15432
BIND_IP=0.0.0.0
HTTP_PORT=8080
SESSION_COOKIE_NAME=SHOP_PROD_SESSION
SESSION_COOKIE_SECURE=false
